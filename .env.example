# Generate unique secrets with npm run shop:setup. Never commit .env.local.
DATABASE_URL=
# Local development only. Production requires a persistent PostgreSQL database.
ORDER_DATABASE_MODE=local
PUBLIC_SITE_URL=http://localhost:3100
SIFT_SESSION_SECRET=
SIFT_ADMIN_PASSWORD_HASH=
CRON_SECRET=
# Optional email notifications: verified sender and Resend API key.
RESEND_API_KEY=
SIFT_EMAIL_FROM=
